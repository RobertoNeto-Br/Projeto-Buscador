# Token do bot no Discord Developer Portal
DISCORD_TOKEN=SEU_TOKEN_AQUI

# Intervalo global inicial em horas (depois pode mudar pelo Discord com /agendar ou pelo site!)
CHECK_INTERVAL_HOURS=6

# Quantidade máxima de links monitorados simultaneamente
MAX_LINKS=5

# Opcional: ID de um canal fixo para receber alertas de mudança de preço
ALERT_CHANNEL_ID=

# Link público do seu painel na Vercel (usado pelo comando /exportar no Discord)
# Ex: https://buscador-precos.vercel.app
WEB_URL=http://localhost:8080

# Na Discloud Gold (TYPE=bot), coloque false para economizar RAM já que a porta 8080 não é pública
ENABLE_WEB_SERVER=true
API_PORT=8080
API_KEY=

# Ponte em nuvem GRATUITA (Supabase) para conectar Discloud Gold + Vercel 24/7
SUPABASE_URL=
SUPABASE_KEY=

# Reciclagem automática de memória (sem perda de dados)
MAX_RAM_MB=155
RECYCLE_INTERVAL_MINUTES=5

# Opcional (grátis permanente: 1.000 req/mês com JS + IP do Brasil): https://scrape.do
SCRAPEDO_TOKEN=
SCRAPERAPI_KEY=
